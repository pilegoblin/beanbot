DISCORD_API_KEY = ""
GOOGLE_API_KEY = ""

# The persona BeanBot answers in.
BEANBOT_BACKSTORY = ""

# IANA timezone that relative times ("friday 8pm") resolve against.
# Defaults to UTC.
BEANBOT_TIMEZONE = "America/New_York"

# How many recent channel messages BeanBot reads as context. Defaults to 50.
BEANBOT_BACKLOG_SIZE = "50"

# Where BeanBot keeps its Memory — one markdown file per server. The directory
# must already exist; BeanBot refuses to start if it doesn't, so a Fly volume
# that failed to mount is caught rather than silently written past. Leave it
# unset to run without long-term memory.
BEANBOT_MEMORY_DIR = "/data"

# How large one server's topical notes may grow, in bytes, before Compaction
# rewrites them smaller. Every message in that server carries them whole, so
# this is a per-request token cost too. Defaults to 8192.
#
# Notes about people are not counted here and are never compacted — nothing
# BeanBot has been told about somebody is ever discarded.
BEANBOT_MEMORY_LIMIT = "8192"

# How many bytes of notes about people one message may carry. The people BeanBot
# knows about are unlimited on disk; this caps how many of them come along when
# a conversation touches several at once. Whoever came up most recently is
# loaded first, and anyone left out is still listed by name. Defaults to 4096.
BEANBOT_RECALL_BUDGET = "4096"
